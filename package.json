{
  "name": "mouzi",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "bun run icons:generate && tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build",
    "build:desktop": "bun run tauri:build",
    "build:app": "bun run tauri:build",
    "build:tauri": "bun run tauri:build",
    "build:debug": "bun run icons:generate && tauri build --debug",
    "build:release": "bun run release",
    "compile": "bun run build",
    "compile:web": "tsc && vite build",
    "compile:desktop": "bun run tauri:build",
    "compile:debug": "bun run icons:generate && tauri build --debug",
    "compile:check": "tsc --noEmit",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons:generate": "tauri icon assets/branding/icons/icon-transparent.png",
    "tauri:dev": "bun run icons:generate && tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "bun run icons:generate && tauri build",
    "tauri:build:debug": "bun run icons:generate && tauri build --debug",
    "posttauri:build": "bun scripts/copy-build-releases.ts",
    "release": "powershell -ExecutionPolicy Bypass -File ./scripts/release/build-release.ps1 -LocalOnly",
    "release:local": "powershell -ExecutionPolicy Bypass -File ./scripts/release/build-release.ps1 -LocalOnly",
    "release:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/release/build-release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.0.10",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
